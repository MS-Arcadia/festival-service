# Arcadia festival service — local configuration.
#
#   cp .env.example .env
#
# Development defaults, not secrets. Every credential here says change-me on purpose.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
HTTP_PORT=8089

# One database and role per service, created by the infra repo's Postgres init script.
DATABASE_URL=postgresql://festival_user:festival_pass@localhost:5432/arcadia_festival
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
RUN_MIGRATIONS=true

# Must match whatever the Auth service signs with. Minimum 32 characters.
JWT_SECRET=local-development-jwt-secret-change-me-please
JWT_ALGORITHM=HS256

# Verified, not optional — these match what the Go wallet and payment services require, so a
# token accepted here is accepted everywhere. Set either to empty to stop checking it, which
# should be a deliberate decision rather than an accident.
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092
KAFKA_ENSURE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION=1
OUTBOX_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100

# ISO-4217. Every amount is an integer count of this currency's minor unit.
CURRENCY=IRR

# auth-profile-service, called synchronously from FestivalService.start to populate
# FestivalStarted's `audience` with every active user id (a festival going live is
# platform-wide — requirement 1.9). See app/adapters/outbound/auth_profile.py and the
# "audience" section of README.md.
AUTH_PROFILE_BASE_URL=http://localhost:8085
AUTH_PROFILE_TIMEOUT_SECONDS=3.0

CORS_ORIGINS=http://localhost:3000
